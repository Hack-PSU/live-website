{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"entry": ["src/app/**/{page,layout,not-found}.tsx"],
	"project": ["src/**/*.{ts,tsx}"],
	"ignore": [
		"src/lib/api/**",
		"src/lib/hooks/use-scroll.ts",
		"src/lib/hooks/use-window-size.ts",
		"src/lib/hooks/use-intersection-observer.ts"
	],
	"ignoreExportsUsedInFile": true
}
